<Window x:Class="QrCodeParser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="二维码解析工具" Height="650" Width="550"
        Icon="pack://application:,,,/assets/qr-qrcode.ico"
        WindowStartupLocation="CenterScreen" Background="#F3F3F3">
    <Grid>
        <TextBlock VerticalAlignment="Top" HorizontalAlignment="Right"
                   Margin="0 4 10 0 "><Hyperlink FontSize="12" NavigateUri="https://github.com/PiedmontStream/QrcodeParserWpf" Click="Hyperlink_Click">关于本软件</Hyperlink></TextBlock>
        <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="UrlTextBox" 
                         Height="36" 
                         VerticalContentAlignment="Center"
                         Padding="8,0"
                         FontSize="14"
                         Background="#FAFAFA"
                         BorderBrush="#E0E0E0"
                         GotFocus="UrlTextBox_GotFocus"/>
                <TextBlock IsHitTestVisible="False" 
                           Text="在此处粘贴包含二维码的图片 URL..." 
                           VerticalAlignment="Center" 
                           Margin="10,0,0,0" 
                           Foreground="#999999"
                           FontSize="14">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Path=Text, ElementName=UrlTextBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Button Grid.Column="1" 
                        Content="解析网络图片" 
                        Width="100" Height="36" 
                        Margin="12,0,0,0"
                        Background="#0078D4" 
                        Foreground="White" 
                        FontWeight="SemiBold"
                        BorderThickness="0"
                        Name="解析按钮"
                        Click="AnalyzeUrl_Click">
                    <Button.Resources>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="1" 
                Background="White" 
                BorderBrush="#B0D0FF" 
                BorderThickness="2" 
                CornerRadius="12"
                AllowDrop="True"
                Drop="UploadArea_Drop"
                DragOver="UploadArea_DragOver"
                MouseLeftButtonDown="UploadArea_MouseLeftButtonDown"
                Name="拖拽区域"
                Cursor="Hand">

            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="#CCCCCC"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="#0078D4"/>
                            <Setter Property="Background" Value="#F9FBFD"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="📁" FontSize="48" HorizontalAlignment="Center" Foreground="#0078D4"/>

                <TextBlock Text="将二维码图片拖拽到此处" 
                           FontSize="16" 
                           FontWeight="Bold" 
                           Margin="0,12,0,4" 
                           HorizontalAlignment="Center" 
                           Foreground="#333333"/>

                <TextBlock Text="或者 点击此处打开文件浏览器选择" 
                           FontSize="13" 
                           HorizontalAlignment="Center" 
                           Foreground="#666666"/>
                <Image x:Name="PreviewImage" MaxHeight="150" Margin="0,16,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="16" Margin="0,16,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="解析结果：" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#333333"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="ResultTextBox" 
                             MinHeight="80" 
                             TextWrapping="Wrap" 
                             AcceptsReturn="True"
                             IsReadOnly="True" 
                             Background="#FAFAFA"
                             BorderBrush="#E0E0E0"
                             Padding="8"
                             FontSize="14"/>

                    <Button Grid.Column="1" 
                            Content="复制" 
                            Width="60" Height="36" 
                            VerticalAlignment="Top"
                            Margin="12,0,0,0"
                            Click="CopyResult_Click"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
    </Grid>
</Window>